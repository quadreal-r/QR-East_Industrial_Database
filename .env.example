# Copy to .env.local for local development
VITE_SUPABASE_URL=supabase_url
VITE_SUPABASE_ANON_KEY=supabase_anon_key
VITE_GOOGLE_MAPS_API_KEY=google_maps_api_key
VITE_GOOGLE_MAPS_MAP_ID=google_maps_map_id

# Localhost-only silent session email (used by Vite; never bundled into the browser).
# Prefer an Admin email. After Logout you can also pick Admin vs Viewer in the top bar.
LOCAL_DEV_EMAIL=you@example.com
# Required by /api/session during local development. Never prefix this with VITE_.
# SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 — public CDN base for RTU pictures (production + local dev against R2)
# Account: quadreal.rpiwin@gmail.com (quadreal) — NOT krutki11
# Example: https://pub-xxxx.r2.dev/ or https://pictures.yourdomain.com/
VITE_RTU_PICTURES_BASE_URL=

# Cloudflare R2 — public CDN base for RTU documents (rtu-documents bucket)
# Account: quadreal (same as pictures)
# Example: https://pub-xxxx.r2.dev/ or https://documents.yourdomain.com/
VITE_RTU_DOCUMENTS_BASE_URL=

# Cloudflare R2 — public CDN for QR-360° tour files (.insp360 / .zip)
# Account: krutki11@gmail.com (krutki11) — separate from RTU media / map Pages host
# The map app (hosted on quadreal) still uses this URL to open/publish integrated tours.
# See docs/CLOUDFLARE_ACCOUNTS.md
# Example: https://pub-xxxx.r2.dev/
VITE_INSP360_BASE_URL=

# Server-side only (migrate-json-to-supabase, upload-rtu-pictures-r2, GitHub Actions)
# Cloudflare Pages must also define SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
# as encrypted server-side secrets for functions/api/session.ts.
# Supabase CLI (db push / link) — create at https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=
# Database password from Supabase project settings (Database → Reset password)
# SUPABASE_DB_PASSWORD=
# R2_ACCOUNT_ID=          # 32-character Account ID (Dashboard → Overview), NOT an API token
# R2_ACCESS_KEY_ID=       # quadreal account (RTU pictures/docs)
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=rtu-pictures
# R2_DOCUMENTS_BUCKET=rtu-documents
# R2_KEY_PREFIX=

# QR-360° tour uploads — krutki11 account ONLY (never reuse R2_* picture keys)
# Create an R2 API token on krutki11@gmail.com for the insp360 bucket.
# Map app hosting stays on quadreal; these secrets only reach krutki11 storage.
# INSP360_R2_ACCOUNT_ID=
# INSP360_R2_ACCESS_KEY_ID=
# INSP360_R2_SECRET_ACCESS_KEY=
# INSP360_R2_BUCKET_NAME=insp360
# INSP360_R2_KEY_PREFIX=
# VITE_INSP360_BASE_URL=https://pub-xxxx.r2.dev/

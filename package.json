{
  "name": "qr-east-industrial-database",
  "private": true,
  "version": "1.14.97",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:onedrive": "scripts\\start-dev.cmd",
    "dev:window": "scripts\\start-dev-window.cmd",
    "dev:persistent": "scripts\\start-dev-persistent.cmd",
    "dev:restart": "scripts\\restart-dev.cmd",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "extract": "tsx scripts/extract.ts",
    "migrate-json-to-supabase": "node scripts/migrate-json-to-supabase.mjs",
    "import-portfolio-excel": "vite-node scripts/import-portfolio-excel-to-supabase.ts",
    "import-capex-hvac-budgets": "vite-node scripts/import-capex-hvac-budgets-to-supabase.ts",
    "import-capex-rtu-notes": "vite-node scripts/import-capex-rtu-notes-to-supabase.ts",
    "import-sylvia-capex": "vite-node scripts/import-sylvia-capex-working-sheet.ts",
    "import-equipment-replacement-years": "vite-node scripts/import-equipment-replacement-years.ts",
    "report-equipment-replacement-years": "vite-node scripts/report-equipment-replacement-years.ts",
    "supabase:link": "supabase link --project-ref wyiymdtlncperqpwriuk",
    "db:push": "node scripts/supabase-db-push.mjs",
    "db:push:dry-run": "node scripts/supabase-db-push.mjs --dry-run",
    "db:migration-list": "supabase migration list --linked",
    "version:bump": "node scripts/bump-version.mjs",
    "version:bump:semver": "node scripts/bump-semver.mjs",
    "version:bump:if-needed": "node scripts/bump-if-local-changes.mjs",
    "upload-rtu-pictures-r2": "node scripts/upload-rtu-pictures-r2.mjs",
    "upload-rtu-documents-r2": "node scripts/upload-rtu-documents-r2.mjs",
    "sync-rtu-pictures-r2": "node scripts/sync-rtu-pictures-r2.mjs",
    "upload-rtu-picture-cloud-aliases": "node scripts/upload-rtu-picture-cloud-aliases.mjs",
    "build-rtu-picture-manifest": "node scripts/build-rtu-picture-manifest.mjs",
    "reset-rtu-pictures": "node scripts/reset-rtu-pictures-from-folder.mjs",
    "clear-rtu-pictures": "node scripts/clear-rtu-pictures.mjs",
    "build-rtu-documents-manifest": "node scripts/build-rtu-documents-manifest.mjs",
    "reconcile-rtu-picture-manifest": "node scripts/reconcile-rtu-picture-manifest.mjs",
    "reconcile-rtu-pictures": "node scripts/reconcile-rtu-picture-manifest.mjs --sync-supabase",
    "report-rtu-picture-gaps": "node scripts/report-rtu-picture-manifest-gaps.mjs",
    "prune-r2-pictures": "node scripts/prune-r2-pictures-by-allowlist.mjs",
    "delete-rtu-pictures-from-list": "node scripts/delete-rtu-pictures-from-list.mjs",
    "upload-rtu-pictures-from-folder": "node scripts/upload-rtu-pictures-from-folder.mjs",
    "compare-local-pictures-cloudflare": "node scripts/compare-local-pictures-with-cloudflare.mjs",
    "push-live": "node scripts/push-live.mjs",
    "restore-point": "node scripts/restore-point.mjs",
    "sync:qr360-viewer": "node scripts/sync-qr360-viewer.mjs",
    "setup:access-branding": "node scripts/setup-access-branding.mjs",
    "upload:insp360": "node scripts/upload-insp360-r2.mjs",
    "build:pages": "node scripts/assert-production-supabase-env.mjs && tsc -b && vite build --base / && node scripts/assert-production-supabase-env.mjs --scan-dist",
    "deploy": "npm run build:pages && npx wrangler pages deploy dist --project-name=qr-east-industrial-database",
    "deploy:preview": "npm run build:pages && npx wrangler pages deploy dist --project-name=qr-east-industrial-database --branch=preview"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^1.16.10",
    "@supabase/supabase-js": "^2.49.8",
    "@tanstack/react-query": "^5.80.7",
    "exceljs": "^4.4.0",
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "jose": "^6.2.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "supabase": "^2.109.0",
    "tsx": "^4.20.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^3.2.4"
  }
}
